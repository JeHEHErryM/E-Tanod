{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @e-tanod/api build"
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @e-tanod/api prisma:deploy",
    "startCommand": "pnpm --filter @e-tanod/api start:prod",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
